+class PatchedGroupManagementEvent:
+    """Retain native group events without treating them as chat messages."""
+
+    def __init__(self, api, event_id, data):
+        self.id = event_id
+        self.raw_data = data
+
+
+def _parse_group_management_event(source, event_type, appid):
+    data = source.raw_data
+    message = AstrBotMessage()
+    message.type = MessageType.GROUP_MESSAGE
+    message.self_id = str(appid)
+    message.group_id = str(data["group_openid"])
+    message.session_id = message.group_id
+    message.sender = MessageMember(
+        user_id=str(data.get("member_openid") or appid),
+        nickname=str(data.get("username") or ""),
+    )
+    message.message_id = str(source.id or f"group-event-{time.time_ns()}")
+    message.message_str = ""
+    message.message = []
+    message.timestamp = int(time.time())
+    message.raw_message = {"t": event_type, "id": source.id, "d": data}
+    return message
+
+
